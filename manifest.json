{
  "manifest_version": 3,
  "name": "Contacts Cleanup",
  "version": "0.1.10",
  "description": "Cleans up your address book: duplicate contacts, phone numbers in one format, missing names, and XMPP chat addresses on cards.",
  "author": "Precision Crab",
  "homepage_url": "https://github.com/precisioncrab/contacts-cleanup",
  "icons": {
    "16": "icons/icon.svg",
    "32": "icons/icon.svg",
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "contacts-cleanup@precisioncrab",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "background": {
    "scripts": [
      "src/background.js"
    ]
  },
  "action": {
    "default_title": "Contacts Cleanup",
    "default_icon": {
      "16": "icons/icon.svg",
      "32": "icons/icon.svg"
    }
  },
  "permissions": [
    "addressBooks",
    "menus",
    "storage"
  ]
}
